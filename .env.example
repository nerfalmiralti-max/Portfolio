# All values below are optional. The site renders correct defaults without them.

# Absolute site URL. Used for canonical URLs, the sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# When empty, the contact form prepares a copyable draft instead of claiming
# a message was sent. Email actions render only when this is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/nerfalmiralti-max

# Project links. Defaults point at the live deployments and public repositories.
NEXT_PUBLIC_99_AKTAU_URL=https://99-aktau.vercel.app/
NEXT_PUBLIC_99_AKTAU_GITHUB_URL=https://github.com/nerfalmiralti-max/99-Aktau

NEXT_PUBLIC_TUESDAY_URL=https://tuesday-eta-eight.vercel.app/
NEXT_PUBLIC_TUESDAY_GITHUB_URL=https://github.com/nerfalmiralti-max/Tuesday

NEXT_PUBLIC_MANGYSTAU_TRIALS_URL=https://mangystau-trials.vercel.app/
NEXT_PUBLIC_MANGYSTAU_TRIALS_GITHUB_URL=https://github.com/nerfalmiralti-max/Mangystau-Trials
